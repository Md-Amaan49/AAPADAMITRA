# ==============================================================================
# AAPADAMITRA — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting services in development mode.
# Never commit .env files containing sensitive credentials to version control.

# Application Environment (development | staging | production)
NODE_ENV=development

# Database Configuration (PostgreSQL placeholder - integration in subsequent milestone)
# Example: postgresql://username:password@localhost:5432/aapadamitra?schema=public
DATABASE_URL=

# Backend API Configuration
API_PORT=3000
API_HOST=localhost
API_GLOBAL_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Frontend Web Application Configuration
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:3000/api/v1

# AI Engine Service Configuration (Python / FastAPI)
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_URL=http://localhost:8000

